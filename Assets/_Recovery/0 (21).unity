  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Instrucciones:\r\n\r\nTienes 6 bolas en 6 huecos desordenados.\r\n\nEl
    objetivo es ordenar las bolas de izquierda a derecha, del 1 al 6, en tres niveles
    diferentes.\r\n\nTienes 6 pasos para lograrlo en cada nivel.\n\r\nPara mover
    las bolas:\r\n\nSolo puedes intercambiar una bola con una que est\xE9 justo al
    lado de ella.\r\n\nPor ejemplo, si la bola 6 quiere moverse, solo puede intercambiar
    con la 3 o la 4 en el caso de que los \xF3rdenes de las bolas son 5 1 2 4 6 3.\r\n\nSi
    te quedas sin pasos y las bolas no est\xE1n en orden, volver\xE1s al principio
    del nivel."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
