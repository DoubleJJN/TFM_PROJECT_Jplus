  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\nC\xF3mo jugar\n\tObserva la rutina que aparece en pantalla.\n\tColoca
    las im\xE1genes en el orden correcto.\n\tArrastra cada imagen hasta la posici\xF3n
    que creas adecuada.\n\nObjetivo\n\tCompleta la rutina colocando todas las im\xE1genes
    en el orden correcto.\n\nNiveles\n\tHay tres niveles diferentes. A medida que
    avances, las rutinas ser\xE1n m\xE1s largas \n\ty dif\xEDciles.\n\nAtenci\xF3n\n\tSi
    colocas las im\xE1genes de forma incorrecta y no consigues completar la rutina,
    \n\tel nivel se reiniciar\xE1.\n\tSi esto ocurre 3 veces, perder\xE1s la partida.\n\nReto\n\t\xA1Piensa
    bien el orden de cada acci\xF3n y completa los 3 niveles!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
