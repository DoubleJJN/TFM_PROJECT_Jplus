  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\nC\xF3mo jugar\n\tJuega colocando tu ficha en una casilla vac\xEDa.\n\tDespu\xE9s
    de cada movimiento, jugar\xE1 tu rival.\n\tPiensa bien d\xF3nde colocar cada
    ficha.\n\nObjetivo\n\tConsigue colocar tres fichas seguidas en horizontal, vertical
    o diagonal antes que \n\ttu rival.\n\nNiveles\n\tHay tres niveles diferentes.
    A medida que avances, el rival ser\xE1 m\xE1s inteligente.\n\nAtenci\xF3n\n\tSi
    pierdes una partida, tendr\xE1s que volver a empezar el nivel.\n\tSi esto ocurre
    3 veces, perder\xE1s la partida.\n\nReto\n\t\xA1Usa la mejor estrategia y supera
    los 3 niveles!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
