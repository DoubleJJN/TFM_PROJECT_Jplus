  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Instrucciones:\r\n\r\nEst\xE1s en un laberinto con una persona y dos objetos:
    un pl\xE1tano y una manzana.\r\n\nCada objeto tiene una puntuaci\xF3n diferente:
    el pl\xE1tano resta 2 puntos y la manzana suma 3 puntos.\r\n\nEl objetivo es
    mover la persona hacia los objetos dependiendo de las puntuaciones de los objetos
    de cada ronda y tus puntos actuales.\r\n\nTienes un n\xFAmero limitado de pasos
    para lograrlo en cada nivel.\r\n\nSi te quedas sin pasos o no logras el objetivo,
    volver\xE1s al primer nivel con los puntos reseteados.\r\n\nIntenta siempre tomar
    los caminos m\xE1s eficientes para evitar problemas."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
